<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Kartlardaki tüm yazılar: Segoe UI (Python sürümündeki "reg" yazı tipi) -->
    <FontFamily x:Key="CardFont">Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Şehir noktaları (soldan sağa). Tıklanınca o şehre geçilir (Tag = "city:N"). -->
    <DataTemplate x:Key="DotTemplate">
        <Border Background="Transparent" Width="9" Height="12" Tag="{Binding Action}" Cursor="Hand">
            <Ellipse Width="{Binding Size}" Height="{Binding Size}" Fill="{Binding Fill}"
                     Opacity="{Binding Opacity}" HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsHitTestVisible="False" />
        </Border>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="DotsPanel">
        <StackPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>

    <!-- Günlük satır (Tam: 5 gün, Haftalık: 7 gün). Satırın üst kenarı = Python yc - 15. -->
    <DataTemplate x:Key="DayRowTemplate">
        <Canvas>
            <TextBlock Canvas.Left="20" Canvas.Top="5" FontSize="14" Text="{Binding Name}"
                       Foreground="{Binding TextBrush}" />
            <Image Canvas.Left="{Binding IconLeft}" Canvas.Top="2" Width="26" Height="26" Source="{Binding Icon}" />
            <TextBlock Canvas.Left="{Binding ProbLeft}" Canvas.Top="7" Width="50" TextAlignment="Right" FontSize="12"
                       Text="{Binding Prob}" FontWeight="{Binding ProbWeight}" Foreground="{Binding ProbBrush}"
                       Visibility="{Binding ProbVisibility}" />
            <TextBlock Canvas.Left="{Binding MinLeft}" Canvas.Top="5" Width="60" TextAlignment="Right" FontSize="14"
                       Text="{Binding Min}" Foreground="{Binding MutedBrush}" />
            <Border Canvas.Left="{Binding TrackLeft}" Canvas.Top="12.5" Width="{Binding TrackWidth}" Height="5"
                    CornerRadius="2.5" Background="{Binding TrackBrush}" />
            <Border Canvas.Left="{Binding BarLeft}" Canvas.Top="12.5" Width="{Binding BarWidth}" Height="5"
                    CornerRadius="2.5" Background="{Binding BarBrush}" />
            <TextBlock Canvas.Left="{Binding MaxLeft}" Canvas.Top="5" Width="50" TextAlignment="Right" FontSize="14"
                       FontWeight="SemiBold" Text="{Binding Max}" Foreground="{Binding TextBrush}" />
        </Canvas>
    </DataTemplate>

    <!-- Yenile simgesi -->
    <Style x:Key="RefreshGlyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="Text" Value="&#xE72C;" />
        <Setter Property="Tag" Value="refresh" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="ToolTip" Value="Yenile" />
    </Style>
</ResourceDictionary>
