<UserControl x:Class="HavaDurumu.Ui.WeeklyCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:HavaDurumu.Ui"
             Width="360" Height="404" FontFamily="{StaticResource CardFont}">
    <!-- Haftalık (360 x 404): 7 gün + 16 günlük eğilim. Python draw_card "weekly" bölümü. -->
    <Border Background="{Binding Background}" CornerRadius="{Binding Radius}"
            BorderBrush="{Binding AccentBrush}" BorderThickness="{Binding AccentThickness}">
        <Canvas ClipToBounds="True" Effect="{Binding ContentEffect}">
            <!-- hava efekti: arka plan ile yazılar arasında (CardAnimator çizer) -->
            <ui:FxHost x:Name="Fx" Width="{Binding Width}" Height="{Binding Height}" />
            <Grid Canvas.Left="20" Canvas.Top="0" Width="{Binding TitleWidth}" Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,13,10,0" FontSize="16" FontWeight="SemiBold" Text="{Binding Title}"
                           TextTrimming="CharacterEllipsis" Foreground="{Binding TextBrush}" />
                <TextBlock Grid.Column="1" Margin="0,16,0,0" FontSize="13" Text="{Binding ClockText}"
                           Foreground="{Binding MutedBrush}" Visibility="{Binding ClockVisibility}" />
            </Grid>
            <TextBlock Style="{StaticResource RefreshGlyph}" Canvas.Left="{Binding RefreshLeft}" Canvas.Top="17"
                       Width="16" Height="16" FontSize="12" Foreground="{Binding MutedBrush}" />

            <TextBlock Canvas.Left="20" Canvas.Top="180" Width="320" TextAlignment="Center" FontSize="15"
                       TextWrapping="Wrap" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                       Visibility="{Binding NoDataVisibility}" />

            <Canvas Width="360" Visibility="{Binding DataVisibility}">
                <Image x:Name="MainIcon" Width="44" Height="44" Canvas.Left="18" Canvas.Top="50" />
                <!-- sıcaklık (Light 30, taban 84) + durum (sb 14) -->
                <StackPanel Orientation="Horizontal" Canvas.Left="70" Canvas.Top="51" MaxWidth="270">
                    <TextBlock FontSize="30" FontWeight="Light" Text="{Binding TempText}"
                               Foreground="{Binding TempBrush}" />
                    <TextBlock FontSize="14" FontWeight="SemiBold" Margin="10,17,0,0" Text="{Binding Condition}"
                               TextTrimming="CharacterEllipsis" Foreground="{Binding TextBrush}" />
                </StackPanel>

                <Rectangle Canvas.Left="20" Canvas.Top="104" Width="320" Height="1" Fill="{Binding FaintBrush}" />
                <TextBlock Canvas.Left="20" Canvas.Top="206" Width="320" TextAlignment="Center" FontSize="13"
                           Text="{Binding WeekEmpty}" Foreground="{Binding MutedBrush}" />
                <ItemsControl ItemsSource="{Binding Days}" ItemTemplate="{StaticResource DayRowTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Top" Value="{Binding Top}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>

                <Rectangle Canvas.Left="20" Canvas.Top="326" Width="320" Height="1" Fill="{Binding FaintBrush}"
                           Visibility="{Binding WeekTrendVisibility}" />
                <TextBlock Canvas.Left="20" Canvas.Top="332" Width="320" TextTrimming="CharacterEllipsis" FontSize="11"
                           Text="{Binding TrendTitle}" Foreground="{Binding MutedBrush}" />
                <TextBlock Canvas.Left="20" Canvas.Top="350" Width="320" TextTrimming="CharacterEllipsis" FontSize="13"
                           FontWeight="SemiBold" Text="{Binding TrendText}" Foreground="{Binding TextBrush}" />

                <TextBlock Canvas.Left="20" Canvas.Top="{Binding FooterTop}" MaxWidth="250" FontSize="11"
                           TextTrimming="CharacterEllipsis" Text="{Binding FooterText}"
                           FontWeight="{Binding FooterWeight}" Foreground="{Binding FooterBrush}" />
            </Canvas>

            <ItemsControl Canvas.Right="20" Canvas.Top="{Binding DotsTop}" ItemsSource="{Binding Dots}"
                          ItemTemplate="{StaticResource DotTemplate}" ItemsPanel="{StaticResource DotsPanel}" />
        </Canvas>
    </Border>
</UserControl>
